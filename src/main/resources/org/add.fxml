<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.nora.dictionary.controllers.AddController">
   <left>
      <AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #D9D9D9;" BorderPane.alignment="CENTER">
